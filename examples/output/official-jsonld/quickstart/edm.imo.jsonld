      ],
      "coverage": [
        {
          "@id": "http://sws.geonames.org/6255147/"
        }
      ],
      "dates": [
        {
          "@value": "ca. 1890/1930"
        }
      ],
      "descriptions": [
        {
          "@value": "Kessel aus einem Stück, mit Loch am Boden sowie am oberen Rand mit 6 eingeschraubten Ösen. Kessel auf einer Höhe von 150 (von unten) nach innen gebogen, so dass\n      sich ein breiter Rand ergibt. Fell über einen Wickelreifen gelegt. Separater Spannreifen Messing, mit 6 Ösen und Spannschrauben. Schrauben mit Vierkantkopf. Spuren einer Halterung mit\n      4 Niten vorhanden (Instrument war sicher am Gürtel oder am Pferdesattel o.ä. befestigt).Birgit Heise, Volker F.Seumel"
        }
      ],
      "titles": [
        {
          "@value": "kleine Pauke"
        },
        {
          "@value": "Kesselpäuklein"
        }
      ],
