  "source": {
    "format": "edm",
    "xml": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<rdf:RDF xmlns:adms=\"http://www.w3.org/ns/adms#\" \n    xmlns:dc=\"http://purl.org/dc/elements/1.1/\" \n    xmlns:dcterms=\"http://purl.org/dc/terms/\" \n    xmlns:edm=\"http://www.europeana.eu/schemas/edm/\" \n    xmlns:odrl=\"http://www.w3.org/ns/odrl/2/\" \n    xmlns:ore=\"http://www.openarchives.org/ore/terms/\" \n    xmlns:rdf=\"http://www.w3.org/1999/02/22-rdf-syntax-ns#\" \n    xmlns:rdfs=\"http://www.w3.org/2000/01/rdf-schema#\" \n    xmlns:schema=\"https://schema.org/\" \n    xmlns:skos=\"http://www.w3.org/2004/02/skos/core#\" \n    xmlns:svcs=\"http://rdfs.org/sioc/services#\"\n    >\n\n    <edm:ProvidedCHO rdf:about=\"TEST_3D_COMPLETE\">\n        <dc:title xml:lang=\"en\">TEST RECORD: Complete version of a 3D object</dc:title>\n        <dc:description xml:lang=\"en\">This is a sample record for a 3D object, presented through 2 complementary embeddable views of the same object. Varios 3D models are made available for download for both views of the object accompained by Paradata. It also contains information about the intended use and source of the model.</dc:description>\n        <dc:creator xml:lang=\"en\">Europeana Data Services Team</dc:creator>\n        <dcterms:isPartOf xml:lang=\"en\">Example Dataset</dcterms:isPartOf>\n        <dcterms:conformsTo xml:lang=\"en\">Partially supported (under development)</dcterms:conformsTo>\n        <edm:rights rdf:resource=\"http://creativecommons.org/licenses/by-sa/4.0/\"/>\n        <dcterms:created xml:lang=\"en\">12th century</dcterms:created>\n        <dcterms:spatial rdf:resource=\"https://sws.geonames.org/3057568/\"/>\n\t\t<dc:type rdf:resource=\"http://www.wikidata.org/entity/Q4989906\"/>\n        <dcterms:spatial rdf:resource=\"http://www.wikidata.org/entity/Q1044029\"/>\n\t\t<dc:subject rdf:resource=\"http://data.europeana.eu/concept/1853\"/>\n        <dcterms:created>01-2026</dcterms:created>\n        <edm:type>3D</edm:type>\n    </edm:ProvidedCHO>\n    \n    <ore:Aggregation rdf:about=\"#Aggregation\">\n        <edm:aggregatedCHO rdf:resource=\"TEST_3D_COMPLETE\"/>\n        <edm:dataProvider>Europeana Foundation</edm:dataProvider>\n        <edm:provider>Europeana Foundation</edm:provider>\n        <edm:isShownAt rdf:resource=\"https://slovakiana.sk/kulturne-objekty/cair-ko4ql9i\"/>\n        <edm:object rdf:resource=\"https://media.sketchfab.com/models/f6ec40a2d6754a6197c188194781f2c3/thumbnails/5eec7f1df11541fb82312b436681d021/daf45450e4da481ea1d8e2fb55832bf3.jpeg\"/>\n        <edm:isShownBy rdf:resource=\"https://sketchfab.com/oembed?url=https%3A%2F%2Fsketchfab.com%2F3d-models%2Fvelky-kliz-kostol-sv-michala-archanjela-f6ec40a2d6754a6197c188194781f2c3&amp;format=json#TEST_3D_COMPLETE\"/>\n        <edm:hasView rdf:resource=\"https://sketchfab.com/oembed?url=https%3A%2F%2Fsketchfab.com%2F3d-models%2Fvelky-kliz-interier-kostol-sv-michala-3d5f53ac99e24c9d9c55aefc83ab83af&amp;format=json#TEST_3D_COMPLETE\"/>\n        <edm:rights rdf:resource=\"http://creativecommons.org/licenses/by-sa/4.0/\"/>\n    </ore:Aggregation>\n\n    <edm:WebResource\n        rdf:about=\"https://sketchfab.com/oembed?url=https%3A%2F%2Fsketchfab.com%2F3d-models%2Fvelky-kliz-kostol-sv-michala-archanjela-f6ec40a2d6754a6197c188194781f2c3&amp;format=json#TEST_3D_COMPLETE\">\n        <dc:title xml:lang=\"sk\">3D model kostola - exteriér</dc:title>\n        <dc:title xml:lang=\"en\">3D model of the church - exterior</dc:title>\n        <dcterms:created>2025</dcterms:created>\n        <dcterms:isFormatOf rdf:resource=\"https://raw.githubusercontent.com/europeana/test_dataset/main/public/models/church_outside.usdz\"/>\n        <dcterms:isFormatOf rdf:resource=\"https://raw.githubusercontent.com/europeana/test_dataset/main/public/models/church_outside_compressed.glb\"/>\n\t\t<rdfs:seeAlso rdf:resource=\"https://raw.githubusercontent.com/europeana/test_dataset/main/public/models/paradata.xlsx\"/>\n        <edm:type>3D</edm:type>\n        <edm:rights rdf:resource=\"http://creativecommons.org/licenses/by-nc-sa/4.0/\"/>\n\t\t<edm:intendedUsage rdf:resource=\"http://data.europeana.eu/vocabulary/usageArea/Documentation\"/>\n        <schema:digitalSourceType rdf:resource=\"https://cv.iptc.org/newscodes/digitalsourcetype/digitalCapture\"/>\n        <svcs:has_service rdf:resource=\"https://sketchfab.com/oembed\"/>\n    </edm:WebResource>\n\n\t<edm:WebResource rdf:about=\"https://sketchfab.com/oembed?url=https%3A%2F%2Fsketchfab.com%2F3d-models%2Fvelky-kliz-interier-kostol-sv-michala-3d5f53ac99e24c9d9c55aefc83ab83af&amp;format=json#TEST_3D_COMPLETE\">\n        <dc:title xml:lang=\"sk\">3D model Kostol - interiér</dc:title>\n        <dc:title xml:lang=\"en\">3D model Church - interior</dc:title>\n        <dcterms:created>2025</dcterms:created>\n        <dcterms:isFormatOf rdf:resource=\"https://raw.githubusercontent.com/europeana/test_dataset/main/public/models/church_interior.glb#TEST_3D_COMPLETE\"/>\n        <dcterms:isFormatOf rdf:resource=\"https://raw.githubusercontent.com/europeana/test_dataset/main/public/models/church_interior_compressed.glb#TEST_3D_COMPLETE\"/>\n        <dcterms:isFormatOf rdf:resource=\"https://raw.githubusercontent.com/europeana/test_dataset/main/public/models/church_interior.usdz#TEST_3D_COMPLETE\"/>\n\t\t<rdfs:seeAlso rdf:resource=\"https://raw.githubusercontent.com/europeana/test_dataset/main/public/models/paradata.xlsx\"/>\n        <edm:type>3D</edm:type>\n        <edm:rights rdf:resource=\"http://creativecommons.org/licenses/by-nc-sa/4.0/\"/>\n\t\t<edm:intendedUsage rdf:resource=\"http://data.europeana.eu/vocabulary/usageArea/Documentation\"/>\n        <schema:digitalSourceType rdf:resource=\"https://cv.iptc.org/newscodes/digitalsourcetype/digitalCapture\"/>\n        <svcs:has_service rdf:resource=\"https://sketchfab.com/oembed\"/>\n    </edm:WebResource>\n\n    <edm:WebResource rdf:about=\"https://raw.githubusercontent.com/europeana/test_dataset/main/public/models/church_outside.usdz#TEST_3D_COMPLETE\">\n        <dc:title xml:lang=\"en\">3D model of the outside view of the Church (High resolution, USDZ version)</dc:title>\n        <dc:description xml:lang=\"en\">The outside view of the Church</dc:description>\n        <dcterms:temporal>02-2026</dcterms:temporal>\n        <edm:type>3D</edm:type>\n        <edm:rights rdf:resource=\"http://creativecommons.org/licenses/by-sa/4.0/\"/>        \n        <edm:intendedUsage rdf:resource=\"http://data.europeana.eu/vocabulary/usageArea/Creativity\"/>\n        <dc:type rdf:resource=\"http://data.europeana.eu/vocabulary/modelType/3DMesh\"/>\n        <edm:polygonCount>3999915</edm:polygonCount>\n        <edm:vertexCount>2591438</edm:vertexCount>\n        <schema:digitalSourceType rdf:resource=\"https://cv.iptc.org/newscodes/digitalsourcetype/digitalCapture\"/>\n     </edm:WebResource>\n\n    <edm:WebResource rdf:about=\"https://raw.githubusercontent.com/europeana/test_dataset/main/public/models/church_outside_compressed.glb#TEST_3D_COMPLETE\">\n        <dc:title xml:lang=\"en\">3D model of the outside view of the Church (Low resolution, GLB version)</dc:title>\n        <dc:description xml:lang=\"en\">The outside view of the Church</dc:description>\n        <dcterms:temporal>02-2026</dcterms:temporal>\n        <edm:type>3D</edm:type>\n        <edm:rights rdf:resource=\"http://creativecommons.org/publicdomain/zero/1.0/\"/>\n        <edm:intendedUsage rdf:resource=\"http://data.europeana.eu/vocabulary/usageArea/Creativity\"/>\n        <dc:type rdf:resource=\"http://data.europeana.eu/vocabulary/modelType/3DMesh\"/>\n        <edm:polygonCount>3999854</edm:polygonCount>\n        <edm:vertexCount>2448420</edm:vertexCount>\n        <schema:digitalSourceType rdf:resource=\"https://cv.iptc.org/newscodes/digitalsourcetype/digitalCapture\"/>\n     </edm:WebResource>\n\n\t<edm:WebResource rdf:about=\"https://raw.githubusercontent.com/europeana/test_dataset/main/public/models/church_interior.glb#TEST_3D_COMPLETE\">\n        <dc:title xml:lang=\"en\">3D model of the inside view of the Church (High resolution, GLB version)</dc:title>\n        <dc:description xml:lang=\"en\">The inside view of the Church showing the altar</dc:description>\n        <dcterms:temporal>12-2023</dcterms:temporal>\n        <edm:type>3D</edm:type>\n        <edm:rights rdf:resource=\"http://creativecommons.org/licenses/by-sa/4.0/\"/>\n        <edm:intendedUsage rdf:resource=\"http://data.europeana.eu/vocabulary/usageArea/Documentation\"/>\n        <dc:type rdf:resource=\"http://data.europeana.eu/vocabulary/modelType/3DMesh\"/>\n        <edm:polygonCount>2512228</edm:polygonCount>\n        <edm:vertexCount>1517930</edm:vertexCount> \n        <schema:digitalSourceType rdf:resource=\"https://cv.iptc.org/newscodes/digitalsourcetype/digitalCapture\"/>   \n    </edm:WebResource>\n\n\t<edm:WebResource rdf:about=\"https://raw.githubusercontent.com/europeana/test_dataset/main/public/models/church_interior_compressed.glb#TEST_3D_COMPLETE\">\n        <dc:title xml:lang=\"en\">3D model of the inside view of the Church (Low resolution, GLB version)</dc:title>\n        <dc:description xml:lang=\"en\">The inside view of the Church showing the altar</dc:description>\n        <dcterms:temporal>02-2026</dcterms:temporal>\n        <edm:type>3D</edm:type>\n        <edm:rights rdf:resource=\"http://creativecommons.org/publicdomain/zero/1.0/\"/>\n        <edm:intendedUsage rdf:resource=\"http://data.europeana.eu/vocabulary/usageArea/Creativity\"/>\n        <dc:type rdf:resource=\"http://data.europeana.eu/vocabulary/modelType/3DMesh\"/>\n        <edm:polygonCount>2512211</edm:polygonCount>\n        <edm:vertexCount>1470002</edm:vertexCount> \n        <schema:digitalSourceType rdf:resource=\"https://cv.iptc.org/newscodes/digitalsourcetype/digitalCapture\"/>   \n    </edm:WebResource>\n\n\t<edm:WebResource rdf:about=\"https://raw.githubusercontent.com/europeana/test_dataset/main/public/models/church_interior.usdz#TEST_3D_COMPLETE\">\n        <dc:title xml:lang=\"en\">3D model of the inside view of the Church (High resolution, USDZ version)</dc:title>\n        <dc:description xml:lang=\"en\">The inside view of the Church showing the altar</dc:description>\n        <dcterms:temporal>12-2023</dcterms:temporal>\n        <edm:type>3D</edm:type>\n        <edm:rights rdf:resource=\"http://creativecommons.org/licenses/by-sa/4.0/\"/>\n        <edm:intendedUsage rdf:resource=\"http://data.europeana.eu/vocabulary/usageArea/Documentation\"/>\n        <dc:type rdf:resource=\"http://data.europeana.eu/vocabulary/modelType/3DMesh\"/>\n        <edm:polygonCount>2512228</edm:polygonCount>\n        <edm:vertexCount>1517930</edm:vertexCount> \n        <schema:digitalSourceType rdf:resource=\"https://cv.iptc.org/newscodes/digitalsourcetype/digitalCapture\"/>   \n    </edm:WebResource>\n\n    <svcs:Service rdf:about=\"https://sketchfab.com/oembed\">\n        <dcterms:conformsTo rdf:resource=\"https://oembed.com/\"/>\n        <rdfs:label xml:lang=\"en\">Sketchfab</rdfs:label>\n    </svcs:Service>\n\n</rdf:RDF>\n"
